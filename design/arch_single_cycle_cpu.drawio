        <mxCell id="p_clk" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;" value="sys_clk_in&#xa;P17 · 100 MHz 晶振" vertex="1">
          <mxGeometry height="60" width="140" x="40" y="120" as="geometry" />
        </mxCell>
        <mxCell id="p_rst" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;" value="sys_rst_n&#xa;P15 · 复位按键（低有效）" vertex="1">
          <mxGeometry height="60" width="140" x="40" y="240" as="geometry" />
        </mxCell>
        <mxCell id="p_out" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;" value="输出引脚&#xa;led_pin[15:0]&#xa;seg_cs_pin[7:0]&#xa;seg_data_0_pin[7:0]&#xa;seg_data_1_pin[7:0]" vertex="1">
          <mxGeometry height="110" width="160" x="1370" y="60" as="geometry" />
        </mxCell>
        <mxCell id="p_in" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;" value="输入引脚&#xa;sw_pin[7:0]&#xa;dip_pin[7:0]&#xa;btn_pin[4:0]" vertex="1">
          <mxGeometry height="90" width="160" x="1370" y="240" as="geometry" />
        </mxCell>
        <mxCell id="m_div" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=11;" value="时钟分频器&#xa;parameter CLK_DIV = 100&#xa;100/200 → 0.5 MHz（默认）&#xa;CLK_DIV=1 → 100 MHz 直连&#xa;原因：组合除法路径 ~570 ns&#xa;无法在 100 MHz 收敛" vertex="1">
          <mxGeometry height="120" width="200" x="260" y="90" as="geometry" />
        </mxCell>
        <mxCell id="m_rst" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=11;" value="复位同步&#xa;两级同步器&#xa;sys_rst_n → rst_n_s1 → rst_n_s2&#xa;内部统一同步低有效 rst_n" vertex="1">
          <mxGeometry height="100" width="200" x="260" y="240" as="geometry" />
        </mxCell>
        <mxCell id="m_cpu" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;" value="cpu_top&#xa;u_cpu（图 1 数据通路）&#xa;&#xa;观测端口悬空：&#xa;pc_out / reg_we /&#xa;reg_wa / reg_wd" vertex="1">
          <mxGeometry height="160" width="220" x="580" y="160" as="geometry" />
        </mxCell>
        <mxCell id="m_pwrite" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=11;" value="外设寄存器（同步写）&#xa;case (mmio_addr[4:2])&#xa;0 → led_r[15:0]&#xa;1 → seg0_r[7:0]&#xa;2 → seg1_r[7:0]&#xa;3 → segcs_r[7:0]" vertex="1">
          <mxGeometry height="130" width="220" x="990" y="90" as="geometry" />
        </mxCell>
        <mxCell id="m_pread" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=11;" value="MMIO 读译码（组合）&#xa;4 → {dip_pin, sw_pin}&#xa;5 → {27&#39;d0, btn_pin}&#xa;其他 → 32&#39;d0" vertex="1">
          <mxGeometry height="100" width="220" x="1040" y="300" as="geometry" />
        </mxCell>
        <mxCell id="mmio_map" parent="1" style="shape=note;whiteSpace=wrap;html=1;size=14;fillColor=#f5f5f5;strokeColor=#999999;align=left;verticalAlign=top;fontSize=11;" value="MMIO 地址映射（DESIGN.md §4.2）&#xa;0xD0000000 W led[15:0]&#xa;0xD0000004 W seg_data0[7:0]&#xa;0xD0000008 W seg_data1[7:0]&#xa;0xD000000C W seg_cs[7:0]&#xa;0xD0000010 R {dip, sw}&#xa;0xD0000014 R btn[4:0]" vertex="1">
          <mxGeometry height="150" width="220" x="900" y="420" as="geometry" />
        </mxCell>
        <mxCell id="e_clk_div" edge="1" parent="1" source="p_clk" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#9673A6;fontSize=11;" target="m_div" value="100 MHz">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e_div_cpu" edge="1" parent="1" source="m_div" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#9673A6;fontSize=11;exitX=1;exitY=0.5;entryX=0;entryY=0.2;" target="m_cpu" value="cpu_clk_out（分频后时钟）">
          <mxGeometry relative="1" as="geometry" />
