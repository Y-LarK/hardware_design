        <mxCell id="e_rst_cpu" edge="1" parent="1" source="m_rst" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#9673A6;fontSize=11;exitX=1;exitY=0.5;entryX=0;entryY=0.8;" target="m_cpu" value="rst_n（同步后）">
