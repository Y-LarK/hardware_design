        </mxCell>
        <mxCell id="e_cpu_pwrite" edge="1" parent="1" source="m_cpu" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#000000;fontSize=11;exitX=1;exitY=0.3;entryX=0;entryY=0.5;" target="m_pwrite" value="mmio_wr / mmio_addr / mmio_wdata / mmio_sel">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e_cpu_pread" edge="1" parent="1" source="m_cpu" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#000000;fontSize=11;exitX=1;exitY=0.7;entryX=0;entryY=0.5;" target="m_pread" value="mmio_addr">
          <mxGeometry relative="1" as="geometry">
            <Array as="points">
              <mxPoint x="800" y="350" />
              <mxPoint x="1020" y="350" />
            </Array>
          </mxGeometry>
        </mxCell>
        <mxCell id="e_pread_cpu" edge="1" parent="1" source="m_pread" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#000000;fontSize=11;exitX=0;exitY=0.25;entryX=1;entryY=0.55;" target="m_cpu" value="mmio_rdata">
          <mxGeometry relative="1" as="geometry">
            <Array as="points">
              <mxPoint x="850" y="285" />
              <mxPoint x="850" y="248" />
            </Array>
          </mxGeometry>
        </mxCell>
        <mxCell id="e_pwrite_led" edge="1" parent="1" source="m_pwrite" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#000000;fontSize=11;exitX=1;exitY=0.2;entryX=0;entryY=0.2;" target="p_out" value="led_r">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e_pwrite_seg" edge="1" parent="1" source="m_pwrite" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#000000;fontSize=11;exitX=1;exitY=0.7;entryX=0;entryY=0.7;" target="p_out" value="seg0_r / seg1_r / segcs_r">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e_pin_pread" edge="1" parent="1" source="p_in" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#000000;fontSize=11;exitX=0;exitY=0.7;entryX=1;entryY=0.5;" target="m_pread" value="{dip, sw} / btn">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e_rst_div" edge="1" parent="1" source="p_rst" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#9673A6;dashed=1;fontSize=10;exitX=0.5;exitY=1;entryX=0.25;entryY=1;" target="m_rst" value="sys_rst_n">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="note_div" parent="1" style="text;html=1;fontSize=10;fontColor=#666666;" value="注意：分频器自由运行，复位只作用于 CPU 与外设寄存器；复位同步器使用 cpu_clk_out 采样" vertex="1">
          <mxGeometry height="20" width="300" x="260" y="360" as="geometry" />
