  <diagram id="tb_all" name="3-Testbench仿真结构">
    <mxGraphModel dx="1389" dy="960" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1300" pageHeight="820" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="title" parent="1" style="text;html=1;fontSize=18;fontStyle=1;align=left;" value="tb_all.v —— 全指令自检仿真平台（sim/tb_all.v，配合 tests/asm/test_all.hex）" vertex="1">
          <mxGeometry height="30" width="800" x="40" y="10" as="geometry" />
        </mxCell>
        <mxCell id="tb" parent="1" style="rounded=0;whiteSpace=wrap;html=1;verticalAlign=top;align=left;spacing=8;fillColor=#f5f5f5;strokeColor=#666666;fontSize=12;" value="tb_all（testbench 顶层）&#xa;&#xa;时钟：always #5 clk = ~clk（100 MHz）&#xa;复位：rst_n=0 上电，#20 ns 拉高&#xa;周期预算：120 万拍（测试程序含 8 段 125ms&#xa;软件延迟共约 50 万拍 + 一倍余量；xsim 约 1 分钟）" vertex="1">
          <mxGeometry height="700" width="1220" x="30" y="70" as="geometry" />
        </mxCell>
        <mxCell id="m_cpu" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;" value="cpu_top&#xa;u_cpu（图 1 数据通路）&#xa;&#xa;程序：$readmemh 装载&#xa;tests/hex/test_all.hex&#xa;（IMEM_FILE 宏）" vertex="1">
          <mxGeometry height="140" width="240" x="80" y="200" as="geometry" />
        </mxCell>
        <mxCell id="m_mon" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;fontSize=12;" value="MMIO 写监视器&#xa;always @(posedge clk)&#xa;捕获 mmio_wr 的每笔写：&#xa;w_addr / w_data 存入环形缓冲&#xa;容量 64 笔（最坏情况取值）&#xa;同时 $display 每笔写" vertex="1">
          <mxGeometry height="140" width="260" x="550" y="150" as="geometry" />
        </mxCell>
        <mxCell id="m_judge" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=12;" value="结果判定（周期预算耗尽后）&#xa;按环形缓冲末几笔匹配写序列" vertex="1">
          <mxGeometry height="80" width="260" x="440" y="440" as="geometry" />
        </mxCell>
        <mxCell id="r_pass" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=11;" value="PASS：末 4 笔 =&#xa;LED=0xFFFFFFFF → segcs=0xFFFFFFFF&#xa;→ seg0=0x7F → seg1=0x7F&#xa;现象：LED 全亮 + 数码管 88888888" vertex="1">
          <mxGeometry height="90" width="280" x="840" y="350" as="geometry" />
        </mxCell>
        <mxCell id="r_fail" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontSize=11;" value="FAIL：末笔 = seg_cs=0x11&#xa;倒数第 5 笔 = LED 错误码&#xa;低 16 位 = 组号*256 + 项号&#xa;（LED 错误码 → seg0=组号 →&#xa;seg_cs=0x01 → seg1=项号 → seg_cs=0x11）" vertex="1">
          <mxGeometry height="110" width="280" x="840" y="510" as="geometry" />
        </mxCell>
        <mxCell id="r_unk" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=11;" value="UNKNOWN：写序列异常&#xa;（不匹配以上两种模式，nw 计数打印）" vertex="1">
          <mxGeometry height="70" width="280" x="800" y="650" as="geometry" />
        </mxCell>
        <mxCell id="note_dev0" parent="1" style="shape=note;whiteSpace=wrap;html=1;size=14;fillColor=#f5f5f5;strokeColor=#999999;align=left;verticalAlign=top;fontSize=11;" value="注意：tb 中 mmio_rdata 接 32&#39;d0（不接外设寄存器），&#xa;测试程序若读 MMIO 输入寄存器读到 0" vertex="1">
          <mxGeometry height="90" width="280" x="70" y="440" as="geometry" />
        </mxCell>
        <mxCell id="note_hex" parent="1" style="shape=note;whiteSpace=wrap;html=1;size=14;fillColor=#f5f5f5;strokeColor=#999999;align=left;verticalAlign=top;fontSize=11;" value="运行方式：&#xa;· Vivado GUI 行为仿真（cpu_single 工程）&#xa;· 或批处理仿真脚本&#xa;· 综合与仿真共用同一 IMEM_FILE 宏装载 hex" vertex="1">
          <mxGeometry height="120" width="280" x="70" y="580" as="geometry" />
        </mxCell>
        <mxCell id="e_clk" edge="1" parent="1" source="tb" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#9673A6;fontSize=11;exitX=0.5;exitY=0;entryX=0.5;entryY=0;" target="m_cpu" value="clk / rst_n">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e_cpu_mon" edge="1" parent="1" source="m_cpu" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#000000;fontSize=11;exitX=1;exitY=0.5;entryX=0;entryY=0.5;" target="m_mon" value="mmio_wr / mmio_addr / mmio_wdata">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e_mon_judge" edge="1" parent="1" source="m_mon" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#000000;fontSize=11;exitX=0.5;exitY=1;entryX=0.5;entryY=0;" target="m_judge" value="w_addr[] / w_data[] / nw">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e_judge_pass" edge="1" parent="1" source="m_judge" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#82b366;fontSize=11;exitX=1;exitY=0.3;entryX=0;entryY=0.5;" target="r_pass">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e_judge_fail" edge="1" parent="1" source="m_judge" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#b85450;fontSize=11;exitX=1;exitY=0.5;entryX=0;entryY=0.5;" target="r_fail">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e_judge_unk" edge="1" parent="1" source="m_judge" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#d6b656;fontSize=11;exitX=1;exitY=0.7;entryX=0;entryY=0.5;" target="r_unk">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e_cpu_ret" edge="1" parent="1" source="note_dev0" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#000000;dashed=1;fontSize=11;exitX=0.5;exitY=0;entryX=0.5;entryY=1;" target="m_cpu" value="mmio_rdata = 32&#39;d0">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
</mxfile>
