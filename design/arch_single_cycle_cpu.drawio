  <diagram id="cpu_board" name="2-板级顶层cpu_board">
    <mxGraphModel dx="1543" dy="1067" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1400" pageHeight="900" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="title" parent="1" style="text;html=1;fontSize=18;fontStyle=1;align=left;" value="板级顶层 cpu_board.v（EGO1 · xc7a35tcsg324-1）" vertex="1">
